  "failure_policy": {
    "invalid_candidates_are_preserved_with_reasons": true,
    "every_l1_lane_requires_a_feasible_candidate": true,
    "missing_feasible_lane_is_stage_failure": true
  },
  "output": {
    "schema": "dynamic_branch_stage4_unit_candidate_inventory_v2",
    "review_state": "unit_candidate_pool_pending_visual_review",
    "complete_candidate_inventory_required": true,
    "whole_composition_selection_present": false,
    "numeric_checks_can_approve_visual_gate": false
  }
}
